{
  "manifest_version": 3,
  "name": "SOKNA Bridge V2.5",
  "version": "2.5.0",
  "description": "Manual active-tab multi-workspace local Windows bridge with GitHub sync guards.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*",
    "http://127.0.0.1:8770/*",
    "http://127.0.0.1:8771/*",
    "http://127.0.0.1:8772/*",
    "http://127.0.0.1:8773/*",
    "http://127.0.0.1:8774/*",
    "http://127.0.0.1:8775/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOKNA Bridge V2.4.1"
  }
}