    foreach($aid in @($m.Keys)){$x=$m[$aid];$pj=[string](Get-SoknaComponentOptional $x 'pending_job_id' '');[int64]$pc=[int64](Get-SoknaComponentOptional $x 'pending_claimed_unix_ms' 0);if($pj-and-not$activeIds.ContainsKey($pj)-and$pc-gt0-and($NowUnixMs-$pc)-gt120000){$x.pending_run_key='';$x.pending_job_id='';$x.pending_claimed_unix_ms=0;$m[$aid]=$x;Write-SoknaAutomationAudit 'automation.pending.recover' $aid ([pscustomobject]@{job_id=$pj})}}
    $claims=@();foreach($id in @($m.Keys|Sort-Object)){$a=$m[$id];if(-not[bool]$a.enabled){continue};$ck=[string]$a.concurrency_key;$pendingForKey=0;foreach($oid in $m.Keys){$o=$m[$oid];if([string](Get-SoknaComponentOptional $o 'concurrency_key' '')-eq$ck-and[string](Get-SoknaComponentOptional $o 'pending_run_key' '')){$pendingForKey++}};if(((Get-SoknaAutomationActiveCount $ActiveJobs $ck)+$pendingForKey)-ge[int]$a.max_concurrency){continue};$runKey='';[int64]$priorNext=[int64]$a.next_run_unix_ms
