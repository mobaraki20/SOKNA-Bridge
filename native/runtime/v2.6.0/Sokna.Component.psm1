function Activate-SoknaComponentRelease([string]$Id,[string]$Version,[switch]$IsRollback){
  $r=Get-SoknaComponentRegistry;$m=Convert-SoknaPropertyMap $r.components;if(-not$m.Contains($Id)){throw'COMPONENT_NOT_FOUND'};$c=$m[$Id];$rels=Convert-SoknaPropertyMap $c.releases;if(-not$rels.Contains($Version)){throw'COMPONENT_RELEASE_NOT_INSTALLED'};$prior=[string]$c.active_version;$txId=[string]$rels[$Version].transaction_id;$txPath=Join-Path $script:ComponentTxRoot ($txId+'.json');if(-not(Test-Path -LiteralPath $txPath)){throw'COMPONENT_TRANSACTION_MISSING'};$tx=Get-Content -LiteralPath $txPath -Raw -Encoding UTF8|ConvertFrom-Json
