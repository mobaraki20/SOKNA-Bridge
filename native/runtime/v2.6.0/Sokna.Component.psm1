  return [ordered]@{ok=$true;schema='sokna-component-manager-status-v1';component_registry=$script:ComponentRegistryPath;component_root=$script:ComponentRoot;component_count=$cm.Count;automation_registry=$script:AutomationRegistryPath;automation_count=$am.Count;process_ownership='pid+start_time+executable+managed-sidecar';release_transaction='stage->verify->activate->health->commit; failure=>rollback';dependency_boundary='Artifact Provider + verified ArtifactRoot only';scheduler_grants='per-run job-scoped grant from non-escalating template'}
