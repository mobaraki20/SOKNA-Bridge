function Register-SoknaAutomation([string]$Id,[string]$WorkspaceId,[string]$PlanPath,[string]$ExpectedSha256,[string]$Type,[int64]$IntervalSeconds,[string]$TriggerKey,[string]$MissedRunPolicy,[string]$ConcurrencyKey,[int]$MaxConcurrency,$GrantScopes,$GrantTools,[int]$GrantTtlSeconds,[int64]$StartUnixMs,[bool]$Enabled=$true){
