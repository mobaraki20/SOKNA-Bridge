  }catch{$failure=$_.Exception.Message;try{$null=Update-SoknaComponentTransaction $tx 'health_fail' 'failed' ([pscustomobject]@{error=$failure})}catch{};try{$current=Get-SoknaComponent $Id;if($null-ne$current.process){try{$null=Stop-SoknaComponent $Id}catch{}};$r2=Get-SoknaComponentRegistry;$m2=Convert-SoknaPropertyMap $r2.components;$cc=$m2[$Id];$cc.active_version=$prior;$cc.state='rolling_back';$cc.health='unknown';$m2[$Id]=$cc;$r2.components=$m2;Save-SoknaComponentRegistry $r2;if($prior){$null=Start-SoknaComponent $Id;$rh=Test-SoknaComponentHealth -Id $Id -Retries 5 -DelayMs 300;if(-not$rh.ok){throw'rollback_health_failed'}};$r2=Get-SoknaComponentRegistry;$m2=Convert-SoknaPropertyMap $r2.components;$cc=$m2[$Id];$cc.state=if($prior){'active'}else{'registered'};$cc.health=if($prior){'healthy'}else{'unknown'};$m2[$Id]=$cc;$r2.components=$m2;Save-SoknaComponentRegistry $r2;$null=Update-SoknaComponentTransaction $tx 'rollback' 'rolled_back' ([pscustomobject]@{restored_version=$prior});Write-SoknaComponentAudit 'component.release.rollback' $Id ([pscustomobject]@{failed_version=$Version;restored_version=$prior;error=$failure})}catch{Write-SoknaComponentAudit 'component.release.rollback.failed' $Id ([pscustomobject]@{failed_version=$Version;error=$_.Exception.Message});throw('COMPONENT_ROLLBACK_FAILED: '+$_.Exception.Message+'; original='+$failure)};throw $failure}
}
function Rollback-SoknaComponent([string]$Id){$c=Get-SoknaComponent $Id;$target=[string]$c.lkg_version;if([string]::IsNullOrWhiteSpace($target)){throw'COMPONENT_LKG_MISSING'};if($target-eq[string]$c.active_version){return [ordered]@{ok=$true;component_id=$Id;changed=$false;active_version=$target}};return (Activate-SoknaComponentRelease -Id $Id -Version $target -IsRollback)}
function Remove-SoknaComponent([string]$Id){
