      else{if($TriggerKey){continue};[int64]$due=[int64]$a.next_run_unix_ms;if($due-le0-or$NowUnixMs-lt$due){continue};[int64]$interval=[int64]$a.interval_seconds*1000;[int64]$missed=[Math]::Floor(($NowUnixMs-$due)/$interval);if($missed-gt0-and[string]$a.missed_run_policy-eq'skip'){$a.next_run_unix_ms=$due+(($missed+1)*$interval);$a.updated_at=(Get-Date).ToUniversalTime().ToString('o');$m[$id]=$a;Write-SoknaAutomationAudit 'automation.missed.skip' $id ([pscustomobject]@{missed=$missed;next_run_unix_ms=$a.next_run_unix_ms});continue};$runKey='interval:'+$id+':'+$due;$a.next_run_unix_ms=$due+(($missed+1)*$interval)}
      if(@($a.recent_run_keys)-contains$runKey){continue};Add-SoknaAutomationRecentKey $a $runKey;$hash=Get-SoknaComponentHash $runKey 20;$jobId='auto-'+$id+'-'+$hash;if($jobId.Length-gt80){$jobId='auto-'+(Get-SoknaComponentHash $id 12)+'-'+$hash};$grantId='ag-'+$hash;$a.pending_run_key=$runKey;$a.pending_job_id=$jobId;$a.pending_claimed_unix_ms=$NowUnixMs;$a.updated_at=(Get-Date).ToUniversalTime().ToString('o');$m[$id]=$a;$claims+=@([ordered]@{automation_id=$id;workspace_id=[string]$a.workspace_id;plan_path=[string]$a.plan_path;expected_sha256=[string]$a.expected_sha256;run_key=$runKey;job_id=$jobId;grant_id=$grantId;grant_issuer='automation:'+$id;grant_scopes=@($a.grant_scopes);grant_tools=@($a.grant_tools);grant_ttl_seconds=[int]$a.grant_ttl_seconds;concurrency_key=$ck;prior_next_run_unix_ms=$priorNext;claimed_next_run_unix_ms=[int64]$a.next_run_unix_ms})
    };$r.automations=$m;Save-SoknaAutomationRegistry $r;foreach($c in $claims){Write-SoknaAutomationAudit 'automation.claim' ([string]$c.automation_id) ([pscustomobject]@{run_key=[string]$c.run_key;job_id=[string]$c.job_id;grant_id=[string]$c.grant_id;concurrency_key=[string]$c.concurrency_key})};return $claims
  }
}
function Undo-SoknaAutomationClaim($Claim){return Invoke-SoknaAutomationLocked {$r=Get-SoknaAutomationRegistry;$m=Convert-SoknaPropertyMap $r.automations;$id=[string]$Claim.automation_id;if(-not$m.Contains($id)){return [ordered]@{ok=$true;restored=$false}};$a=$m[$id];$rk=[string]$Claim.run_key;if([string]$a.pending_run_key-ne$rk){return [ordered]@{ok=$true;restored=$false;reason='newer_claim'}};$a.recent_run_keys=@($a.recent_run_keys|Where-Object{[string]$_-ne$rk});$a.last_run_key='';$a.pending_run_key='';$a.pending_job_id='';$a.pending_claimed_unix_ms=0;if([string]$a.type-eq'interval'){$a.next_run_unix_ms=[int64]$Claim.prior_next_run_unix_ms};$a.updated_at=(Get-Date).ToUniversalTime().ToString('o');$m[$id]=$a;$r.automations=$m;Save-SoknaAutomationRegistry $r;Write-SoknaAutomationAudit 'automation.claim.undo' $id ([pscustomobject]@{run_key=$rk;job_id=[string]$Claim.job_id});return [ordered]@{ok=$true;restored=$true}}}
