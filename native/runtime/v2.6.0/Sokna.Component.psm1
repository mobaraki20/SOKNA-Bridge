function Get-SoknaAutomationClaims($ActiveJobs,[int64]$NowUnixMs=0,[string]$TriggerKey='',[string]$EventId=''){
  if($NowUnixMs-le0){$NowUnixMs=[DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()};if($TriggerKey-and(-not(Test-SoknaComponentId $TriggerKey))){throw'AUTOMATION_TRIGGER_KEY_INVALID'};if($TriggerKey-and(-not(Test-SoknaComponentId $EventId))){throw'AUTOMATION_EVENT_ID_INVALID'}
  return Invoke-SoknaAutomationLocked {
    $r=Get-SoknaAutomationRegistry;$m=Convert-SoknaPropertyMap $r.automations;$activeIds=@{};foreach($j in @($ActiveJobs)){if(([string](Get-SoknaComponentOptional $j 'status' ''))-in@('queued','running')){$activeIds[[string](Get-SoknaComponentOptional $j 'id' '')]=$true}}
