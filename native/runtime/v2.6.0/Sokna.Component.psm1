  $policy=Test-SoknaWorkspaceGrantPolicy -WorkspaceId $WorkspaceId -Scopes $GrantScopes -Tools $GrantTools;$now=[DateTimeOffset]::UtcNow;$next=0;if($kind-eq'interval'){$next=if($StartUnixMs-gt0){$StartUnixMs}else{$now.AddSeconds($IntervalSeconds).ToUnixTimeMilliseconds()}}
  return Invoke-SoknaAutomationLocked { $r=Get-SoknaAutomationRegistry;$m=Convert-SoknaPropertyMap $r.automations;if($m.Contains($Id)){throw'AUTOMATION_ALREADY_EXISTS'};$a=[ordered]@{id=$Id;workspace_id=$WorkspaceId;plan_path=$PlanPath;expected_sha256=$ExpectedSha256;type=$kind;interval_seconds=$IntervalSeconds;trigger_key=$TriggerKey;missed_run_policy=$MissedRunPolicy;concurrency_key=$ConcurrencyKey;max_concurrency=$MaxConcurrency;grant_scopes=@($policy.scopes);grant_tools=@($policy.tools);grant_ttl_seconds=$GrantTtlSeconds;enabled=$Enabled;next_run_unix_ms=$next;last_run_key='';recent_run_keys=@();pending_run_key='';pending_job_id='';pending_claimed_unix_ms=0;created_at=$now.ToString('o');updated_at=$now.ToString('o')};$m[$Id]=$a;$r.automations=$m;Save-SoknaAutomationRegistry $r;Write-SoknaAutomationAudit 'automation.register' $Id ([pscustomobject]@{type=$kind;workspace_id=$WorkspaceId;concurrency_key=$ConcurrencyKey;grant_policy='intersection'});return $a }
}
function Get-SoknaAutomationList{$r=Get-SoknaAutomationRegistry;$m=Convert-SoknaPropertyMap $r.automations;$out=@();foreach($id in @($m.Keys|Sort-Object)){$out+=$m[$id]};return $out}
