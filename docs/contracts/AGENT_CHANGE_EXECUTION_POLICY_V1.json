{
  "schema": "sokna-agent-execution-policy-v1",
  "status": "mandatory",
  "control_plane": {
    "safe_command_json_bytes": 600,
    "inline_mutating_shell": false,
    "inline_payload_base64": false,
    "two_strike_remote_rule": true
  },
  "source": {
    "full_source_required_for_nontrivial_change": true,
    "exact_base_required": true,
    "user_machine_is_development_environment": false
  },
  "artifact": {
    "complete_unit_of_work": true,
    "expected_sha256_required_for_apply": true,
    "target_workspace_required": true,
    "target_branch_required": true,
    "target_base_required": true,
    "handoff_required": true,
    "declared_files_must_equal_patch_files": true,
    "git_apply_check_required": true,
    "preserve_unknown_untracked": true,
    "rename_supported_v1": false
  },
  "release_scripts": {
    "powershell_aliases_allowed": false,
    "static_parse_required": true,
    "hash_manifest_required": true
  },
  "activation": {
    "side_by_side_stage": true,
    "recovery_point_required": true,
    "activation_plan_required": true,
    "health_required": true,
    "automatic_rollback_on_health_failure": true
  },
  "acceptance": {
    "ping_version": true,
    "capability_version": true,
    "artifact_inspect": true,
    "artifact_apply_probe_and_reverse": true,
    "audit_events": true,
    "tracked_repo_clean_after_probe": true
  },
  "handoff": {
    "required_at_meaningful_checkpoint": true,
    "exact_next_action_required": true,
    "rollback_path_required": true
  },
  "efficiency": {
    "target_primary_round_trips": 2,
    "remote_trial_and_error_allowed": false
  },
  "reentrancy": {
    "agent_mediated_self_http_allowed": false,
    "agent_mediated_health_evidence": [
      "control_plane_invocation",
      "pid_ownership",
      "runtime_version_on_disk",
      "capability_version_on_disk"
    ],
    "external_http_health_required_after_restart": true,
    "dependency_cycle_review_required": true
  },
  "windows_startup_probe": {
    "required_before_activation": true,
    "mode": "target-process-no-live-bind",
    "capture_stdout_stderr": true,
    "random_httplistener_port_forbidden": true
  },
  "runtime_launcher_logging": {
    "stdout": true,
    "stderr": true,
    "exit_code": true
  },
  "windows_state_schema_regression": {
    "required_before_activation": true,
    "isolated_temp_root": true,
    "must_use_shipped_launcher": true,
    "hard_stop_on_failure": true,
    "fields": [
      "active_version",
      "recovered_at",
      "accepted_at"
    ]
  }
}