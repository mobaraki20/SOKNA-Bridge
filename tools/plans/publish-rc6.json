{
  "id": "publish-rc6-v1",
  "steps": [
    {"name":"working-diff-check","action":"process.run","stop_on_error":true,"params":{"exe":"git","args":["diff","--check"],"mutating":false}},
    {"name":"stage-rc6","action":"git.add","stop_on_error":true,"params":{}},
    {"name":"staged-diff-check","action":"process.run","stop_on_error":true,"params":{"exe":"git","args":["diff","--cached","--check"],"mutating":false}},
    {"name":"commit-rc6","action":"git.commit","stop_on_error":true,"params":{"message":"release: canonicalize SOKNA Agent 2.6.0-rc6"}},
    {"name":"tag-rc6","action":"process.run","stop_on_error":true,"params":{"exe":"git","args":["tag","sokna-agent-2.6.0-rc6"],"mutating":true}},
    {"name":"push-rc6","action":"process.run","stop_on_error":true,"params":{"exe":"git","args":["push","origin","dev/bootstrap-v2.5","sokna-agent-2.6.0-rc6"],"mutating":true,"timeout_sec":300}},
    {"name":"head","action":"process.run","params":{"exe":"git","args":["rev-parse","HEAD"],"mutating":false}},
