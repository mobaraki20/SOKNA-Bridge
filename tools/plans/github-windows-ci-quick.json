{
  "id": "github-windows-ci-quick-v1",
  "steps": [
    {
      "name": "github-windows-ci-quick",
      "action": "process.run",
      "stop_on_error": true,
      "params": {
        "exe": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "tools/ci/Invoke-GitHubWindowsCI.ps1",
          "-Profile",
          "quick",
          "-TimeoutSec",
          "900"
        ],
        "timeout_sec": 1200
      }
    }
  ]
}
