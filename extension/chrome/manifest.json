{
    "manifest_version":  3,
    "name":  "SOKNA Bridge V3.9.1 Reliable Transport",
    "version":  "3.9.1",
    "description":  "Reliable queued delivery with immediate idle-state retry, stale pending suppression, safer Base64URL handling, and draft/attachment protection.",
    "key":  "",
    "permissions":  [
                        "storage",
                        "alarms",
                        "activeTab",
                        "nativeMessaging",
                        "webNavigation"
                    ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "SOKNA Bridge V3.9.1"
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://gpt.arzanai.com/*"
                                            ],
                                "js":  [
                                           "dom_core.js",
                                           "content.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "ISOLATED",
                                "all_frames":  true,
                                "match_about_blank":  true,
                                "match_origin_as_fallback":  true
                            }
                        ],
    "host_permissions":  [
                             "https://gpt.arzanai.com/*"
                         ],
    "minimum_chrome_version":  "111"
}