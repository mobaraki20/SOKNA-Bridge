{
  "manifest_version": 3,
  "name": "SOKNA Bridge",
  "version": "3.12.0",
  "description": "Connect ChatGPT to the local SOKNA Agent with controlled workspaces, diagnostics, artifacts and browser helpers.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "nativeMessaging",
    "webNavigation",
    "downloads"
  ],
  "background": {
    "service_worker": "background_bootstrap.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOKNA Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gpt.arzanai.com/*"
      ],
      "js": [
        "protocol.js",
        "semantic_gate.js",
        "semantic_core.js",
        "semantic_intent.js",
        "chat_artifact_core.js",
        "outbound_attachment_core.js",
        "dom_core.js",
        "outbound_attachment.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram_capture.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gpt.arzanai.com/*",
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "minimum_chrome_version": "111"
}
