{
  "manifest_version": 3,
  "name": "SOKNA Bridge V3.10.8 Guarded Transport",
  "version": "3.10.8",
  "description": "Guarded V4/V3 transport with durable queued delivery and automatic terminal job summaries.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "nativeMessaging",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOKNA Bridge V3.10.8"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gpt.arzanai.com/*"
      ],
      "js": [
        "protocol.js",
        "dom_core.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "host_permissions": [
    "https://gpt.arzanai.com/*"
  ],
  "minimum_chrome_version": "111"
}
